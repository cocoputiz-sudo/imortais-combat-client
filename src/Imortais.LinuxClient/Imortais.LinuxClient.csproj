<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IMORTAIS-Combat-Client</AssemblyName>
    <RootNamespace>Imortais.LinuxClient</RootNamespace>
    <ApplicationVersion>1.0.0</ApplicationVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Libpcap" Version="0.1.5" />
    <!-- Overrides Avalonia's vulnerable transitive 0.21.2 (NU1903 / GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\upstream\AlbionOnline-StatisticsAnalysis\src\StatisticsAnalysisTool.PhotonPackageParser\StatisticsAnalysisTool.PhotonPackageParser.csproj" />
    <!-- Same telemetry core as the Windows client: pairing, routing, outbox, payloads. -->
    <ProjectReference Include="..\Imortais.ClientCore\Imortais.ClientCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Albion event/operation codes maintained in the Windows client (game patches fixed once). -->
    <Compile Include="..\..\upstream\AlbionOnline-StatisticsAnalysis\src\StatisticsAnalysisTool\Network\EventCodes.cs" Link="Network\Shared\EventCodes.cs" />
    <Compile Include="..\..\upstream\AlbionOnline-StatisticsAnalysis\src\StatisticsAnalysisTool\Network\OperationCodes.cs" Link="Network\Shared\OperationCodes.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Imortais.LinuxClient.ContractTests" />
  </ItemGroup>
</Project>
