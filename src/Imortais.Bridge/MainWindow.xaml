<Window x:Class="Imortais.Bridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IMORTAIS Combat Client" Height="700" Width="1020" MinHeight="620" MinWidth="880" Background="#080B10" Foreground="#EDF2F7">
<Window.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="#10151D"/><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#243040"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="Button"><Setter Property="Background" Value="#151C26"/><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#33425A"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Window.Resources>
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="IMORTAIS" FontSize="26" FontWeight="Bold"/><TextBlock Text="COMBAT CLIENT · Statistics Bridge" Foreground="#D9AA52" FontSize="12"/></StackPanel>
<Border Grid.Row="1" Background="#10151D" BorderBrush="#243040" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,14,0"><TextBlock Text="Servidor Railway" Foreground="#8190A5"/><TextBox x:Name="UrlBox" Margin="0,4,0,10"/><TextBlock Text="Chave do agente" Foreground="#8190A5"/><TextBox x:Name="KeyBox" Margin="0,4,0,10"/><TextBlock Text="Jogador" Foreground="#8190A5"/><TextBox x:Name="PlayerBox" Margin="0,4,0,10"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="Device ID" Foreground="#8190A5"/><TextBox x:Name="DeviceBox" Margin="0,4,0,10"/><TextBlock Text="CTA Event ID (opcional)" Foreground="#8190A5"/><TextBox x:Name="CtaBox" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="SALVAR" Click="Save_Click" Background="#A92631"/><Button Content="TESTAR CONEXÃO" Click="Test_Click"/><Button Content="DEMO" Click="Demo_Click"/></StackPanel><TextBlock x:Name="StatusText" Text="● aguardando configuração" Margin="0,14,0,0" Foreground="#E2B95E"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#10151D" BorderBrush="#243040" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,14,0"><StackPanel><TextBlock Text="STATUS" FontWeight="Bold" Foreground="#8190A5"/><TextBlock x:Name="QueueText" Text="Fila: 0" FontSize="20" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="PartyText" Text="Party observada: 0"/><TextBlock x:Name="LootText" Text="Loot observado: 0"/><TextBlock x:Name="DamageText" Text="Damage events: 0"/><TextBlock x:Name="DeathText" Text="Mortes: 0"/><Separator Margin="0,16" Background="#243040"/><TextBlock Text="Este cliente recebe eventos do núcleo do Statistics Analysis e os envia para o War Room. O botão DEMO comprova toda a rota PC → Railway." TextWrapping="Wrap" Foreground="#8190A5"/></StackPanel></Border>
<Border Grid.Column="1" Background="#10151D" BorderBrush="#243040" BorderThickness="1" CornerRadius="10" Padding="16"><DockPanel><TextBlock DockPanel.Dock="Top" Text="EVENTOS CAPTURADOS" FontWeight="Bold" Foreground="#8190A5" Margin="0,0,0,10"/><ListBox x:Name="EventsList" Background="#0B0F15" Foreground="#EDF2F7" BorderThickness="0"/></DockPanel></Border></Grid>
</Grid></Window>
