<Window x:Class="StatisticsAnalysisTool.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:networkModel="clr-namespace:StatisticsAnalysisTool.Models.NetworkModel"
        xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
        xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
        xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DesignHeight="850" d:DesignWidth="1150"
        Title="Guild Combat Client"
        Icon="../Assets/imortais-icon.png"
	
        Closing="MainWindow_OnClosing"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Style="{StaticResource MainWindowStyle}">

    <Grid Style="{StaticResource MainGridStyle}">
        <Grid Style="{StaticResource BackgroundImageGridStyle}" />

        <Grid ZIndex="-1" Style="{StaticResource MainHeader.Root}" MouseDown="Hotbar_MouseDown" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="18" />
                <RowDefinition Height="33" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <Grid Grid.RowSpan="4" Grid.ColumnSpan="3" Style="{StaticResource MainHeader.Background}" />

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}" Content="0" Click="MinimizeButton_Click" />
                <Button x:Name="MaximizedButton" Style="{StaticResource WindowButtonStyle}" Content="1" Click="MaximizeButton_Click" />
                <Button IsEnabled="{Binding IsCloseButtonActive}" Style="{StaticResource WindowButtonStyle}" Content="r" Click="CloseButton_Click" />
            </StackPanel>

            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource MainHeader.StatusContainer}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Translation.Status, FallbackValue=STATUS}" Style="{StaticResource MainHeaderStatus.Title}" />
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsGameDataDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.GameDataStatusText, FallbackValue=WAITING__FOR__GAME__DATA}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsServerDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.ServerStatusText, FallbackValue=SERVER__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsCharacterDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.CharacterStatusText, FallbackValue=CHARACTER__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsLocationDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.LocationStatusText, FallbackValue=LOCATION__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Style="{StaticResource Image.ToolIcon}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Height="38">
                    <Label Content="GUILD COMBAT CLIENT" Style="{StaticResource MainWindow.Title}" />
                    <Grid Visibility="{Binding UnsupportedOsVisibility, FallbackValue=Collapsed}"
                          Height="20" Width="20" VerticalAlignment="Center" ToolTip="{Binding Translation.UnsupportedOs, FallbackValue='UNSUPPORTED_OS'}">
                        <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" />
                    </Grid>
                    <Label Content="- DEBUG -" Style="{StaticResource MainWindow.Title}" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}"
                           Visibility="{Binding DebugModeVisibility}" />
                    <Grid Style="{StaticResource LoadingIconGridStyle}">
                        <fa:FontAwesomeImage Visibility="{Binding LoadIconVisibility}" Style="{StaticResource LoadingIconStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.UsernameInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.Username, FallbackValue=USERNAME}" ContentStringFormat="{}{0}: " />
                        <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.Username, FallbackValue=USERNAME}" />
                        <Grid Visibility="{Binding TrackingActivityBindings.CharacterIsNotTrackedInfoVisibility, FallbackValue=Visible}" Margin="3,0,0,0" Height="12" Width="12"
                              ToolTip="{Binding Translation.ThisCharacterIsNotTracked, FallbackValue=THIS_CHARACTER_IS_NOT_TRACKED}">
                            <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}" Margin="0,2,0,0" />
                        </Grid>
                        <TextBlock Text="|" Style="{StaticResource MainHeader.TrackingSeparator}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.GuildInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.GuildCap, FallbackValue=GUILD}" ContentStringFormat="{}{0}: " />
                        <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.GuildName, FallbackValue=GUILD__NAME}" />
                        <TextBlock Text="|" Style="{StaticResource MainHeader.TrackingSeparator}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.AllianceInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.Alliance, FallbackValue=ALLIANCE}" ContentStringFormat="{}{0}: " />
                        <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.AllianceName, FallbackValue=ALLIANCE__NAME}" />
                        <TextBlock Text="|" Style="{StaticResource MainHeader.TrackingSeparator}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.CurrentMapInfoBinding.CurrentMapInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.CurrentMap, FallbackValue=CURRENT__MAP}" ContentStringFormat="{}{0}: " />
                        <ContentControl Content="{Binding UserTrackingBindings.CurrentMapInfoBinding}" ContentTemplate="{StaticResource CurrentMapInfoTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{Binding PartyMemberNumber, FallbackValue=0}" d:Content="20" Style="{StaticResource MainHeader.PartyCount}" />
                <Grid Grid.Column="1" Style="{StaticResource MainHeader.PartyCopyButton}" PreviewMouseDown="CopyPartyToClipboard_PreviewMouseDown">
                    <fa:FontAwesomeImage Icon="SolidUsers" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                </Grid>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding PartyMemberCircles}" Style="{StaticResource MainHeader.PartyMembers}">
                    <d:ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type networkModel:PartyMemberCircle}">
                            <networkModel:PartyMemberCircle Name="Triky313" />
                            <networkModel:PartyMemberCircle Name="Rhaegaryn" />
                            <networkModel:PartyMemberCircle Name="Dicky" />
                            <networkModel:PartyMemberCircle Name="faxerix" />
                            <networkModel:PartyMemberCircle Name="Test Player 05" />
                            <networkModel:PartyMemberCircle Name="Test Player 06" />
                            <networkModel:PartyMemberCircle Name="Test Player 07" />
                            <networkModel:PartyMemberCircle Name="Test Player 08" />
                            <networkModel:PartyMemberCircle Name="Test Player 09" />
                            <networkModel:PartyMemberCircle Name="Test Player 10" />
                            <networkModel:PartyMemberCircle Name="Test Player 11" />
                            <networkModel:PartyMemberCircle Name="Test Player 12" />
                            <networkModel:PartyMemberCircle Name="Test Player 13" />
                            <networkModel:PartyMemberCircle Name="Test Player 14" />
                            <networkModel:PartyMemberCircle Name="Test Player 15" />
                            <networkModel:PartyMemberCircle Name="Test Player 16" />
                            <networkModel:PartyMemberCircle Name="Test Player 17" />
                            <networkModel:PartyMemberCircle Name="Test Player 18" />
                            <networkModel:PartyMemberCircle Name="Test Player 19" />
                            <networkModel:PartyMemberCircle Name="Test Player 20" />
                        </x:Array>
                    </d:ItemsControl.ItemsSource>
                </ItemsControl>
            </Grid>

            <Grid Grid.Row="2" Grid.ColumnSpan="3" Grid.Column="0" Width="24" HorizontalAlignment="Center" PreviewMouseDown="TatsDropDownOpenClose_PreviewMouseDown">
                <fa:FontAwesomeImage Icon="SolidAnglesDown" Foreground="{StaticResource SolidColorBrush.Text.1}" Width="10" Height="10" Margin="0,0,0,2" VerticalAlignment="Bottom" />
            </Grid>

            <ProgressBar Grid.Row="3" Grid.ColumnSpan="3" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ToolTaskProgressBarValue, FallbackValue=0}" />

            <Label Grid.Row="2" Grid.Column="2" x:Name="ApplicationUptimeLabel" HorizontalAlignment="Right" Margin="0,0,10,12" Style="{StaticResource HeaderStyle.Tracking.Content}" Content="00:00:00" />
        </Grid>

        <!-- Stats drop down -->
        <Grid ZIndex="3" Height="90" MaxWidth="500" Margin="0,90,5,0" HorizontalAlignment="Center" VerticalAlignment="Top"
              Background="{StaticResource SolidColorBrush.Background.3}" Visibility="{Binding StatsDropDownVisibility, FallbackValue=Visible}">
            <Border BorderBrush="{StaticResource SolidColorBrush.Text.7}" BorderThickness="1">
                <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/fame.png" Width="22" Height="22" ToolTip="{Binding Translation.Fame, FallbackValue=FAME}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedFameInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.FamePerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/silver.png" Width="22" Height="22" ToolTip="{Binding Translation.Silver, FallbackValue=SILVER}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedSilverInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.SilverPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/respec.png" Width="22" Height="22" ToolTip="{Binding Translation.ReSpec, FallbackValue=RESPEC}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedReSpecPointsInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.ReSpecPointsPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/might.png" Width="22" Height="22" ToolTip="{Binding Translation.Might, FallbackValue=MIGHT}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedMightInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.MightPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/favor.png" Width="22" Height="22" ToolTip="{Binding Translation.Favor, FallbackValue=FAVOR}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedFavorInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.FavorPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FactionPointStats}" ItemTemplate="{StaticResource FactionPointStatsTemplate}" />
                </DockPanel>
            </Border>
        </Grid>

        <TabControl Style="{DynamicResource TabControlStyle}" SelectedIndex="0">
            <TabItem Header="GUILD" Tag="pack://application:,,,/Assets/imortais-icon.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <Grid Style="{StaticResource BackgroundImageGridStyle}" />
                    <ScrollViewer x:Name="GuildHomeScrollViewer" Padding="15,10,15,15" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Cabeçalho: produto, guilda atendida e versão -->
                            <Border Style="{StaticResource App.TopFilterCard}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="GUILD COMBAT CLIENT" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12"
                                                   Text="Telemetria do Albion para o War Room da sua guilda"
                                                   Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource App.FilterGroup}">
                                            <StackPanel>
                                                <TextBlock Text="GUILDA" Style="{StaticResource App.FilterLabel}" />
                                                <TextBlock x:Name="GuildHomeGuildNameText" Text="IMORTAIS" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="VERSÃO" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsVersionText" Text="v0.6.8" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Situação em cartões, no mesmo padrão do Dashboard -->
                            <UniformGrid Columns="4" Margin="0,0,-8,8">
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="WAR ROOM" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock x:Name="ImortaisHomeWarRoomStatusText" Margin="0,10,0,0" Text="● VERIFICANDO..."
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="Gold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="TELEMETRIA" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock x:Name="ImortaisHomeTelemetryStatusText" Margin="0,10,0,0" Text="● AGUARDANDO..."
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="Gold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="ALBION" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock x:Name="ImortaisHomeAlbionStatusText" Margin="0,10,0,0" Text="● AGUARDANDO DADOS..."
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="Gold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="CTA" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock x:Name="ImortaisHomeCtaStatusText" Margin="0,10,0,0" Text="NENHUM CTA ATIVO"
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,0,-8,10">
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="PERSONAGEM" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding UserTrackingBindings.Username, FallbackValue=AGUARDANDO}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="GUILDA NO JOGO" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding UserTrackingBindings.GuildName, FallbackValue=AGUARDANDO}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="MAPA" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <ContentControl Margin="0,10,0,0"
                                                        Content="{Binding UserTrackingBindings.CurrentMapInfoBinding}"
                                                        ContentTemplate="{StaticResource CurrentMapInfoTemplate}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Dashboard.CombatMetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="PARTY" Style="{StaticResource Dashboard.CombatMetricTitle}" />
                                        <TextBlock x:Name="ImortaisHomePartyStatusText" Margin="0,10,0,0" Text="0 detectados"
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Ativação: escolher a guilda e informar o código -->
                            <Border Style="{StaticResource Dashboard.Section}" Padding="16,12,16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Ativação na guilda" Style="{StaticResource Dashboard.SectionTitle}" />
                                    <TextBlock x:Name="ImortaisPairingHelpText" Margin="0,6,0,10" TextWrapping="Wrap"
                                               Text="Escolha a guilda (ou cole o endereço do War Room dela), gere um código de 6 dígitos no War Room e informe abaixo. Tem personagens em mais de uma guilda? Ative uma vez em cada: o client envia para a guilda do personagem logado."
                                               Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="GUILDA" Style="{StaticResource App.FilterLabel}" />
                                            <ComboBox x:Name="GuildServerComboBox" Width="260" Height="34" IsEditable="True"
                                                      VerticalContentAlignment="Center"
                                                      ToolTip="Guilda cadastrada ou endereço https do War Room da sua guilda" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="CÓDIGO" Style="{StaticResource App.FilterLabel}" />
                                            <TextBox x:Name="ImortaisPairingCodeTextBox" Width="150" Height="34"
                                                     MaxLength="6" FontSize="16" VerticalContentAlignment="Center"
                                                     ToolTip="Código de ativação de 6 dígitos" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Button x:Name="ImortaisPairingButton" Content="ATIVAR TELEMETRIA"
                                                    Height="34" MinWidth="180"
                                                    Click="ImortaisPairing_Click" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="ImortaisPairingStatusText" Margin="0,8,0,0"
                                               Text="Verificando estado do pareamento..." Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                    <TextBlock x:Name="ImortaisGuildLinkText" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                               Text="AGUARDANDO O JOGO INFORMAR SUA GUILDA" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                    <TextBlock x:Name="ImortaisPairingsText" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                </StackPanel>
                            </Border>

                            <!-- Highlights -->
                            <Border Style="{StaticResource Dashboard.Section}" Padding="16,12,16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,0">
                                        <TextBlock Text="Highlights · replay buffer" Style="{StaticResource Dashboard.SectionTitle}" />
                                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                                                   Text="Quando ativada, captura somente a janela e o áudio do processo do Albion. Mantém até 150 s de vídeo H.264 e PCM em memória; o replay final usa H.264 + AAC. Não envia vídeo ao War Room."
                                                   Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                        <TextBlock x:Name="ImortaisHighlightStatusText" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                                                   Text="Gravação em segundo plano desligada."
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                        <TextBlock x:Name="ImortaisHighlightMetricsText" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11" Text="Buffer: 0 s · 0 MiB"
                                                   Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" MinWidth="205">
                                        <Button x:Name="ImortaisBackgroundRecordingButton" MinWidth="205" Height="42"
                                                Content="GRAVAÇÃO: NÃO" Click="ImortaisBackgroundRecording_Click" />
                                        <ComboBox x:Name="ImortaisHighlightFpsCombo" Margin="0,8,0,0" MinWidth="205" Height="32"
                                                  SelectionChanged="ImortaisHighlightFps_SelectionChanged">
                                            <ComboBoxItem Content="30 FPS · máquina fraca" Tag="30" />
                                            <ComboBoxItem Content="60 FPS · padrão" Tag="60" />
                                        </ComboBox>
                                        <CheckBox x:Name="ImortaisAutoSaveAbatesCheckBox" Margin="0,9,0,0"
                                                  Content="Salvar meus abates" Click="ImortaisAutoSaveOption_Click" />
                                        <CheckBox x:Name="ImortaisAutoSaveDeathsCheckBox" Margin="0,6,0,0" IsChecked="False"
                                                  Content="Salvar quando eu MORRER"
                                                  ToolTip="Gatilho em DiedEvent letal do próprio personagem; morte tem prioridade sobre abates no mesmo replay."
                                                  Click="ImortaisAutoSaveOption_Click" />
                                        <CheckBox x:Name="ImortaisAutoSaveMassAbatesCheckBox" Margin="0,6,0,0" IsChecked="False"
                                                  Content="Salvar abates em massa"
                                                  ToolTip="Desativado por padrão: múltiplos abates ainda podem ser salvos por Salvar meus abates."
                                                  Click="ImortaisAutoSaveOption_Click" />
                                        <Button x:Name="ImortaisSaveTestReplayButton" Margin="0,8,0,0" MinWidth="205" Height="36"
                                                IsEnabled="False" Content="SALVAR REPLAY DE TESTE" Click="ImortaisSaveTestReplay_Click" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="10"
                                               Text="No Windows 10 a borda amarela de captura pode permanecer. No Windows 11 o cliente tenta remover a borda quando a API permitir. Se o modo tela cheia exclusivo não fornecer frames válidos, use Janela ou Tela Cheia sem Bordas."
                                               Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                </Grid>
                            </Border>

                            <!-- Diagnóstico -->
                            <Border Style="{StaticResource Dashboard.Section}" Padding="16,12,16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Diagnóstico" Style="{StaticResource Dashboard.SectionTitle}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="UPDATER" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsUpdaterText" Text="AINDA NÃO VERIFICADO" Foreground="Gold" Margin="0,0,0,8" />
                                            <TextBlock Text="ÚLTIMA CHECAGEM" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsLastCheckText" Text="ainda não realizada" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="ÚLTIMO CONTATO" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsLastContactText" Text="aguardando" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="OUTBOX" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsOutboxText" Text="0 eventos" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="HEARTBEAT" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsHeartbeatText" Text="aguardando" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="ALBION DETECTADO" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsGameText" Text="aguardando" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PARTY SNAPSHOT" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsPartyText" Text="nenhum snapshot" TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="GUILD PRESENCE" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsGuildText" Text="aguardando eventos" TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="GUILD MIGHT" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsMightText" Text="Enviados 0 · Aceitos 0 · Erros 0 · Pendentes 0" TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />
                                            <TextBlock Text="ÚLTIMO ERRO" Style="{StaticResource App.FilterLabel}" />
                                            <TextBlock x:Name="ImortaisDiagnosticsErrorText" Text="nenhum" TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="ATIVIDADE RECENTE" Style="{StaticResource App.FilterLabel}" Margin="0,12,0,4" />
                                    <Border Style="{StaticResource Dashboard.Card}" Padding="10,8">
                                        <TextBlock x:Name="ImortaisDiagnosticsActivityText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                                   Text="Nenhuma atividade registrada nesta sessão."
                                                   Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                    </Border>

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="ImortaisCheckForUpdateButton" Content="VERIFICAR ATUALIZAÇÃO" Height="34" MinWidth="180"
                                                Margin="0,0,10,10" Click="ImortaisCheckForUpdate_Click" />
                                        <Button Content="COPIAR DIAGNÓSTICO" Height="34" MinWidth="170" Margin="0,0,10,10"
                                                Click="CopyImortaisDiagnostics_Click" />
                                        <Button Content="EXPORTAR DIAGNÓSTICO DE EVENTOS" Height="34" MinWidth="260" Margin="0,0,10,10"
                                                ToolTip="Exporta contagens e formatos dos eventos Photon; não inclui nomes, IDs nem valores"
                                                Click="ExportImortaisEventDiagnostics_Click" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button x:Name="ImortaisGuildDumpToggleButton" Content="GUILD DUMPS: DESLIGADO" Height="34" MinWidth="185"
                                                Margin="0,0,10,10"
                                                ToolTip="Cópia local de Might e Guild Challenge; Might também usa a telemetria normal"
                                                Click="ImortaisGuildDumpToggle_Click" />
                                        <Button Content="ABRIR PASTA DE DUMPS" Height="34" MinWidth="170" Margin="0,0,10,10"
                                                Click="ImortaisOpenGuildDumps_Click" />
                                        <Button x:Name="ImortaisDeathReviewToggleButton" Content="DEATH REVIEW: LIGADO" Height="34" MinWidth="205"
                                                Margin="0,0,10,10"
                                                ToolTip="Registra localmente dados da própria morte, pode ser desligado. Não envia relatórios ao War Room."
                                                Click="ImortaisDeathReviewToggle_Click" />
                                        <Button Content="ABRIR DEATH REVIEWS" Height="34" MinWidth="170" Margin="0,0,10,10"
                                                Click="ImortaisOpenDeathReviewFolder_Click" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                               Text="Death Review salva apenas neste PC relatórios das suas mortes (até 30 JSONs), com nomes/IDs, dano, habilidades e equipamento. Nada é enviado automaticamente." />
                                    <TextBlock Text="Captura local dos rankings de Might e Challenge; desligado por padrão." FontSize="11"
                                               Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Text="CAPTURA VPN / EXITLAG / NOPING / WARP" Style="{StaticResource App.FilterLabel}" Margin="0,14,0,4" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,7" Foreground="{StaticResource SolidColorBrush.Text.3}"
                                               Text="Se utiliza VPN ou acelerador de rota, informe aqui. O modo registra somente contadores locais e evita recuperações automáticas baseadas em silêncio de rede. Não cria VPN nem garante decodificar tráfego criptografado." />
                                    <WrapPanel>
                                        <Button x:Name="ImortaisVpnAssistToggleButton" Content="USO VPN: NÃO" Height="34" MinWidth="150" Margin="0,0,10,0"
                                                Click="ImortaisVpnAssistToggle_Click" />
                                        <Button x:Name="ImortaisVpnRescanButton" Content="REEXAMINAR INTERFACES" Height="34" MinWidth="190"
                                                Click="ImortaisVpnRescan_Click"
                                                ToolTip="Somente quando solicitado: pede ao capturador Npcap reexaminar as interfaces. Pode interromper momentaneamente os eventos." />
                                    </WrapPanel>
                                    <TextBlock x:Name="ImortaisVpnCaptureStatusText" Text="VPN: aguardando diagnóstico" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                               Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                    <TextBlock x:Name="ImortaisBuildIdentityLabel" Text="BUILD: verificando..." Margin="0,10,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="2,0,2,6" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SolidColorBrush.Text.3}"
                                       Text="Party, loot, dano, cura e mortes são observados passivamente. Nenhum CTA precisa estar aberto para usar o cliente; quando não houver CTA ativo, os eventos ficam sem vínculo de CTA." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Visibility="{Binding DashboardTabVisibility, Mode=OneWay}" Header="{Binding Translation.Dashboard, FallbackValue=DASHBOARD}" Tag="pack://application:,,,/Assets/Navigation/dashboard.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:DashboardControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.ItemSearch, FallbackValue=ITEM__SEARCH}" Tag="pack://application:,,,/Assets/Navigation/magnifying-glass.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:ItemSearchControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="{Binding LoggingTabVisibility, Mode=OneWay}" Header="{Binding Translation.Logging, FallbackValue=LOGGING}" Tag="pack://application:,,,/Assets/Navigation/log.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:LoggingControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.Dungeons, FallbackValue=DUNGEONS}" Tag="pack://application:,,,/Assets/Navigation/dark.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:DungeonControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="{Binding DamageMeterTabVisibility, Mode=OneWay}" Header="{Binding Translation.DamageMeter, FallbackValue=DAMAGE__METER}" Tag="pack://application:,,,/Assets/Navigation/bar-chart-rotated.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:DamageMeterControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.TradeMonitoring, FallbackValue=TRADE__MONITORING}" Tag="pack://application:,,,/Assets/Navigation/market.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:TradeMonitoringControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.Gathering, FallbackValue=GATHERING}" Tag="pack://application:,,,/Assets/Navigation/pickaxe.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:GatheringControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.Crafting, FallbackValue=CRAFTING}" Tag="pack://application:,,,/Assets/Navigation/anvil.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:CraftingControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="{Binding PartyTabVisibility, Mode=OneWay}" Header="{Binding Translation.Party, FallbackValue=PARTY}" Tag="pack://application:,,,/Assets/Navigation/teamwork.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:PartyControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.Guild, FallbackValue=GUILD}" Tag="pack://application:,,,/Assets/Navigation/shield.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:GuildControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.StorageHistory, FallbackValue=STORAGE_HISTORY}" Tag="pack://application:,,,/Assets/Navigation/treasure.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:StorageHistoryControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.MapHistory, FallbackValue=MAP__HISTORY}" Tag="pack://application:,,,/Assets/Navigation/location.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:MapHistoryControl DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Header="{Binding Translation.PlayerInformation, FallbackValue=PLAYER__INFORMATION}" Tag="pack://application:,,,/Assets/Navigation/baseball-player.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:PlayerInformationControl />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Style="{StaticResource ItemContainerDonationStyle}" Header="{Binding Translation.Donations, FallbackValue=DONATIONS}" Tag="pack://application:,,,/Assets/Navigation/money.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:DonationControl />
                </Grid>
            </TabItem>
            <TabItem Visibility="Collapsed" Style="{StaticResource ItemContainerThanksStyle}" Header="{Binding Translation.Thanks, FallbackValue=THANKS}" Tag="pack://application:,,,/Assets/heart.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:ThanksControl />
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Translation.Settings, FallbackValue=SETTINGS}" Tag="pack://application:,,,/Assets/Navigation/setting.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <userControls:SettingsControl />
                </Grid>
            </TabItem>
        </TabControl>

        <userControls:FooterControl VerticalAlignment="Bottom" Height="40" />
        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
            <userControls:ErrorBarControl VerticalAlignment="Bottom" Visibility="{Binding ErrorBarVisibility, FallbackValue=Collapsed}" ErrorText="{Binding ErrorBarText}" ErrorException="{Binding ErrorBarException}" />
            <userControls:WarningBarControl VerticalAlignment="Bottom" Visibility="{Binding WarningBarVisibility, FallbackValue=Collapsed}" WarningText="{Binding WarningBarText}" />
            <userControls:InformationBarControl VerticalAlignment="Bottom" Visibility="{Binding InformationBarVisibility, FallbackValue=Collapsed}" InformationText="{Binding InformationBarText}" />
        </StackPanel>
    </Grid>
</Window>



