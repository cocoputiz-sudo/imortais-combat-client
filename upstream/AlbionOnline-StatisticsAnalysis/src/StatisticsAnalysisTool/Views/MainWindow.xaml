<Window x:Class="StatisticsAnalysisTool.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:StatisticsAnalysisTool.Common.Controls"
        xmlns:networkModel="clr-namespace:StatisticsAnalysisTool.Models.NetworkModel"
        xmlns:userControls="clr-namespace:StatisticsAnalysisTool.UserControls"
        xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
        xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DesignHeight="850" d:DesignWidth="1150"
        Title="IMORTAIS Combat Client"
        Icon="../Assets/imortais-icon.png"
	
        Closing="MainWindow_OnClosing"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Style="{StaticResource MainWindowStyle}">

    <Grid Style="{StaticResource MainGridStyle}">
        <Grid Style="{StaticResource BackgroundImageGridStyle}" />

        <Grid ZIndex="-1" Style="{StaticResource MainHeader.Root}" MouseDown="Hotbar_MouseDown" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="18" />
                <RowDefinition Height="33" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <Grid Grid.RowSpan="4" Grid.ColumnSpan="3" Style="{StaticResource MainHeader.Background}" />

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}" Content="0" Click="MinimizeButton_Click" />
                <Button x:Name="MaximizedButton" Style="{StaticResource WindowButtonStyle}" Content="1" Click="MaximizeButton_Click" />
                <Button IsEnabled="{Binding IsCloseButtonActive}" Style="{StaticResource WindowButtonStyle}" Content="r" Click="CloseButton_Click" />
            </StackPanel>

            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource MainHeader.StatusContainer}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Translation.Status, FallbackValue=STATUS}" Style="{StaticResource MainHeaderStatus.Title}" />
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsGameDataDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.GameDataStatusText, FallbackValue=WAITING__FOR__GAME__DATA}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsServerDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.ServerStatusText, FallbackValue=SERVER__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsCharacterDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.CharacterStatusText, FallbackValue=CHARACTER__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsLocationDetected}">
                        <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                        <TextBlock Text="{Binding MainStatusBindings.LocationStatusText, FallbackValue=LOCATION__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Style="{StaticResource Image.ToolIcon}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Height="38">
                    <Label Content="IMORTAIS COMBAT CLIENT" Style="{StaticResource MainWindow.Title}" />
                    <Grid Visibility="{Binding UnsupportedOsVisibility, FallbackValue=Collapsed}"
                          Height="20" Width="20" VerticalAlignment="Center" ToolTip="{Binding Translation.UnsupportedOs, FallbackValue='UNSUPPORTED_OS'}">
                        <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" />
                    </Grid>
                    <Label Content="- DEBUG -" Style="{StaticResource MainWindow.Title}" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}"
                           Visibility="{Binding DebugModeVisibility}" />
                    <Grid Style="{StaticResource LoadingIconGridStyle}">
                        <fa:FontAwesomeImage Visibility="{Binding LoadIconVisibility}" Style="{StaticResource LoadingIconStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.UsernameInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.Username, FallbackValue=USERNAME}" ContentStringFormat="{}{0}: " />
                        <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.Username, FallbackValue=USERNAME}" />
                        <Grid Visibility="{Binding TrackingActivityBindings.CharacterIsNotTrackedInfoVisibility, FallbackValue=Visible}" Margin="3,0,0,0" Height="12" Width="12"
                              ToolTip="{Binding Translation.ThisCharacterIsNotTracked, FallbackValue=THIS_CHARACTER_IS_NOT_TRACKED}">
                            <fa:FontAwesomeImage Icon="SolidTriangleExclamation" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}" Margin="0,2,0,0" />
                        </Grid>
                        <TextBlock Text="|" Style="{StaticResource MainHeader.TrackingSeparator}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.GuildInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.GuildCap, FallbackValue=GUILD}" ContentStringFormat="{}{0}: " />
                        <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.GuildName, FallbackValue=GUILD__NAME}" />
                        <TextBlock Text="|" Style="{StaticResource MainHeader.TrackingSeparator}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.AllianceInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.Alliance, FallbackValue=ALLIANCE}" ContentStringFormat="{}{0}: " />
                        <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.AllianceName, FallbackValue=ALLIANCE__NAME}" />
                        <TextBlock Text="|" Style="{StaticResource MainHeader.TrackingSeparator}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.CurrentMapInfoBinding.CurrentMapInformationVisibility, FallbackValue=Visible}">
                        <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.CurrentMap, FallbackValue=CURRENT__MAP}" ContentStringFormat="{}{0}: " />
                        <ContentControl Content="{Binding UserTrackingBindings.CurrentMapInfoBinding}" ContentTemplate="{StaticResource CurrentMapInfoTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{Binding PartyMemberNumber, FallbackValue=0}" d:Content="20" Style="{StaticResource MainHeader.PartyCount}" />
                <Grid Grid.Column="1" Style="{StaticResource MainHeader.PartyCopyButton}" PreviewMouseDown="CopyPartyToClipboard_PreviewMouseDown">
                    <fa:FontAwesomeImage Icon="SolidUsers" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                </Grid>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding PartyMemberCircles}" Style="{StaticResource MainHeader.PartyMembers}">
                    <d:ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type networkModel:PartyMemberCircle}">
                            <networkModel:PartyMemberCircle Name="Triky313" />
                            <networkModel:PartyMemberCircle Name="Rhaegaryn" />
                            <networkModel:PartyMemberCircle Name="Dicky" />
                            <networkModel:PartyMemberCircle Name="faxerix" />
                            <networkModel:PartyMemberCircle Name="Test Player 05" />
                            <networkModel:PartyMemberCircle Name="Test Player 06" />
                            <networkModel:PartyMemberCircle Name="Test Player 07" />
                            <networkModel:PartyMemberCircle Name="Test Player 08" />
                            <networkModel:PartyMemberCircle Name="Test Player 09" />
                            <networkModel:PartyMemberCircle Name="Test Player 10" />
                            <networkModel:PartyMemberCircle Name="Test Player 11" />
                            <networkModel:PartyMemberCircle Name="Test Player 12" />
                            <networkModel:PartyMemberCircle Name="Test Player 13" />
                            <networkModel:PartyMemberCircle Name="Test Player 14" />
                            <networkModel:PartyMemberCircle Name="Test Player 15" />
                            <networkModel:PartyMemberCircle Name="Test Player 16" />
                            <networkModel:PartyMemberCircle Name="Test Player 17" />
                            <networkModel:PartyMemberCircle Name="Test Player 18" />
                            <networkModel:PartyMemberCircle Name="Test Player 19" />
                            <networkModel:PartyMemberCircle Name="Test Player 20" />
                        </x:Array>
                    </d:ItemsControl.ItemsSource>
                </ItemsControl>
            </Grid>

            <Grid Grid.Row="2" Grid.ColumnSpan="3" Grid.Column="0" Width="24" HorizontalAlignment="Center" PreviewMouseDown="TatsDropDownOpenClose_PreviewMouseDown">
                <fa:FontAwesomeImage Icon="SolidAnglesDown" Foreground="{StaticResource SolidColorBrush.Text.1}" Width="10" Height="10" Margin="0,0,0,2" VerticalAlignment="Bottom" />
            </Grid>

            <ProgressBar Grid.Row="3" Grid.ColumnSpan="3" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ToolTaskProgressBarValue, FallbackValue=0}" />

            <Label Grid.Row="2" Grid.Column="2" x:Name="ApplicationUptimeLabel" HorizontalAlignment="Right" Margin="0,0,10,12" Style="{StaticResource HeaderStyle.Tracking.Content}" Content="00:00:00" />
        </Grid>

        <!-- Stats drop down -->
        <Grid ZIndex="3" Height="90" MaxWidth="500" Margin="0,90,5,0" HorizontalAlignment="Center" VerticalAlignment="Top"
              Background="{StaticResource SolidColorBrush.Background.3}" Visibility="{Binding StatsDropDownVisibility, FallbackValue=Visible}">
            <Border BorderBrush="{StaticResource SolidColorBrush.Text.7}" BorderThickness="1">
                <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/fame.png" Width="22" Height="22" ToolTip="{Binding Translation.Fame, FallbackValue=FAME}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedFameInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.FamePerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/silver.png" Width="22" Height="22" ToolTip="{Binding Translation.Silver, FallbackValue=SILVER}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedSilverInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.SilverPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/respec.png" Width="22" Height="22" ToolTip="{Binding Translation.ReSpec, FallbackValue=RESPEC}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedReSpecPointsInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.ReSpecPointsPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/might.png" Width="22" Height="22" ToolTip="{Binding Translation.Might, FallbackValue=MIGHT}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedMightInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.MightPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                        <Image Source="../Resources/favor.png" Width="22" Height="22" ToolTip="{Binding Translation.Favor, FallbackValue=FAVOR}" />
                        <TextBlock Text="{Binding DashboardBindings.TotalGainedFavorInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="16" Text="{Binding DashboardBindings.FavorPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FactionPointStats}" ItemTemplate="{StaticResource FactionPointStatsTemplate}" />
                </DockPanel>
            </Border>
        </Grid>

        <TabControl Style="{DynamicResource TabControlStyle}" SelectedIndex="0">
            <TabItem Header="IMORTAIS" Tag="pack://application:,,,/Assets/imortais-icon.png">
                <Grid Style="{StaticResource TabItemGridStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="30,24,30,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="IMORTAIS COMBAT CLIENT"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,4,0,0"
                                       Text="Telemetria do Albion → CTA War Room"
                                       FontSize="13"
                                       Foreground="{StaticResource SolidColorBrush.Text.4}" />

                            <Border Grid.Row="2"
                                    Margin="0,18,0,0"
                                    MinHeight="305"
                                    Padding="18"
                                    Background="{StaticResource SolidColorBrush.Background.3}"
                                    BorderBrush="{StaticResource SolidColorBrush.Text.7}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                               Text="STATUS"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="WAR ROOM" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ImortaisHomeWarRoomStatusText" Text="● VERIFICANDO..." VerticalAlignment="Center" Foreground="Gold" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ALBION" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ImortaisHomeAlbionStatusText" Text="● AGUARDANDO DADOS..." VerticalAlignment="Center" Foreground="Gold" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PERSONAGEM" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding UserTrackingBindings.Username, FallbackValue=AGUARDANDO}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="GUILD" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{Binding UserTrackingBindings.GuildName, FallbackValue=AGUARDANDO}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="MAPA" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <ContentControl Grid.Row="5" Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding UserTrackingBindings.CurrentMapInfoBinding}"
                                                    ContentTemplate="{StaticResource CurrentMapInfoTemplate}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="CTA" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ImortaisHomeCtaStatusText" Text="NENHUM CTA ATIVO" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.4}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="PARTY" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ImortaisHomePartyStatusText" Text="0 detectados" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.4}" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="TELEMETRIA" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ImortaisHomeTelemetryStatusText" Text="● AGUARDANDO..." VerticalAlignment="Center" Foreground="Gold" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="3"
                                    Margin="0,18,0,0"
                                    Padding="18"
                                    Background="{StaticResource SolidColorBrush.Background.3}"
                                    BorderBrush="{StaticResource SolidColorBrush.Text.7}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="ATIVAÇÃO DA TELEMETRIA" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                    <TextBlock x:Name="ImortaisPairingHelpText" Margin="0,8,0,8"
                                               Text="Se este computador ainda não estiver ativado, gere um código de 6 dígitos no War Room e informe abaixo."
                                               TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ImortaisPairingCodeTextBox" Width="180" Height="34"
                                                 MaxLength="6" FontSize="16" VerticalContentAlignment="Center"
                                                 ToolTip="Código de ativação de 6 dígitos" />
                                        <Button x:Name="ImortaisPairingButton" Content="ATIVAR TELEMETRIA"
                                                Height="34" MinWidth="180" Margin="10,0,0,0"
                                                Click="ImortaisPairing_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ImortaisPairingStatusText" Margin="0,8,0,0"
                                               Text="Aguardando ativação" Foreground="{StaticResource SolidColorBrush.Text.4}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4"
                                    Margin="0,18,0,0"
                                    Padding="18"
                                    Background="{StaticResource SolidColorBrush.Background.3}"
                                    BorderBrush="{StaticResource SolidColorBrush.Text.7}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                               Text="DIAGNÓSTICO"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="VERSÃO" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ImortaisDiagnosticsVersionText" Text="v0.4.9" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="UPDATER" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ImortaisDiagnosticsUpdaterText" Text="AINDA NÃO VERIFICADO" Foreground="Gold" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ÚLTIMA CHECAGEM" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ImortaisDiagnosticsLastCheckText" Text="ainda não realizada" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ÚLTIMO CONTATO" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ImortaisDiagnosticsLastContactText" Text="aguardando" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="OUTBOX" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ImortaisDiagnosticsOutboxText" Text="0 eventos" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="HEARTBEAT" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ImortaisDiagnosticsHeartbeatText" Text="aguardando" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="PARTY SNAPSHOT" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ImortaisDiagnosticsPartyText" Text="nenhum snapshot" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="GUILD PRESENCE" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ImortaisDiagnosticsGuildText" Text="aguardando eventos" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="ALBION DETECTADO" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" x:Name="ImortaisDiagnosticsGameText" Text="aguardando" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,4,0,0" Text="ÚLTIMO ERRO" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,4,0,0" x:Name="ImortaisDiagnosticsErrorText"
                                               Text="nenhum" TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush.Text.3}" />

                                    <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                        <TextBlock Text="ATIVIDADE RECENTE" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        <TextBlock x:Name="ImortaisDiagnosticsActivityText"
                                                   Margin="0,6,0,0"
                                                   Text="Nenhuma atividade registrada nesta sessão."
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SolidColorBrush.Text.3}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="ImortaisCheckForUpdateButton"
                                                Content="VERIFICAR ATUALIZAÇÃO"
                                                Height="34"
                                                MinWidth="180"
                                                Margin="0,0,10,0"
                                                Click="ImortaisCheckForUpdate_Click" />
                                        <Button Content="COPIAR DIAGNÓSTICO"
                                                Height="34"
                                                MinWidth="170"
                                                Click="CopyImortaisDiagnostics_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

